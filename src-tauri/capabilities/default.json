{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "두 프로그램의 창이 쓰는 권한: 첫 창(main — 연표 프로그램에서는 연표, 메이커 프로그램에서는 메이커)과 메이커 안의 연표 미리보기 창(index). 파일 대화상자, 앱 데이터 폴더 읽기·쓰기, 외부 링크, 창 열기",
  "windows": ["main", "index"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "dialog:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }]
    }
  ]
}
