{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HistoryTimeline",
  "version": "0.0.4",
  "identifier": "com.historytimeline.app",
  "build": {
    "frontendDist": "../dist/web",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "역사 연표",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
