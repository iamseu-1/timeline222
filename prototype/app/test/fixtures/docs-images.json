,"a":1,"b":0,"c":1,"d":2,"text2":"\t"},{"section":46,"track":0,"row":0,"row2":0,"start":-745796160,"end":-725808960,"lod":13,"ref":"sample-doc-images/p-haeon","name":"","color":0,"a":1,"b":0,"c":2,"d":3,"text2":"\t"},{"section":46,"track":0,"row":0,"row2":0,"start":-725808960,"end":-678474720,"lod":14,"ref":"sample-doc-images/p-haeon","name":"","color":0,"a":1,"b":0,"c":3,"d":4,"text2":"\t"},{"section":20,"track":0,"row":0,"row2":0,"start":-762626880,"end":-678474720,"lod":-1,"ref":"sample-doc-images/p-haeon","name":"해온국","color":13152659,"a":0,"b":0,"c":0,"d":0,"text2":""},{"section":45,"track":0,"row":0,"row2":0,"start":-762626880,"end":-678474720,"lod":-1,"ref":"sample-doc-images/p-haeon","name":"해온국","color":13152659,"a":0,"b":0,"c":0,"d":0,"text2":""}],"entities":[{"uid":"doc:sample-doc-images/e-route","kind":"doc","json":"{\"key\":\"sample-doc-images/e-route\",\"title\":\"남쪽 뱃길 열림\",\"meta\":\"사건 · 560년 · 해온 바다\",\"base\":\"sample-doc-images/e-route\",\"body\":\"== 뱃길 ==\\n[[파일:img-sea]]\\n두 번째 임금 때 열린 남쪽 뱃길입니다. 같은 그림을 id(img-sea)로 적었습니다.\",\"pack\":\"샘플: 문서 그림 — 오른쪽에 띄운 그림과 흐르는 글\",\"uid\":\"sample-doc-images/e-route\",\"span\":[-741588480,-741588480],\"images\":{\"img-sea\":{\"key\":\"img:sample-doc-images/img-sea\",\"mime\":\"image/webp\",\"bytes\":8316,\"w\":800,\"h\":450,\"caption\":\"남쪽 바닷길 — 포구 셋을 잇는 뱃길 (확인용 그림)\",\"alt\":\"솔뫼 · 물섬 · 남녘 포구를 점선 뱃길로 이은 바다 그림\",\"credit\":\"확인용 견본\"}}}","pack":0},{"uid":"doc:sample-doc-images/p-haeon","kind":"doc","json":"{\"key\":\"sample-doc-images/p-haeon\",\"title\":\"해온국\",\"meta\":\"국가 · 520년 ~ 680년 · 해온 바다\",\"base\":\"sample-doc-images/p-haeon\",\"body\":\"== 개요 ==\\n'''해온국'''은 이 견본의 확인용 가상 나라입니다. 바닷길을 열고 도읍을 두 번 옮겼다고 적어 두었습니다.\\n== 바닷길 ==\\n[[파일:남쪽 바닷길.webp]]\\n두 번째 임금 때 남쪽 바다로 나가는 길을 열었습니다.[* 확인용 각주 — 고증 아님] 포구 셋을 잇는 뱃길이었고, 철마다 바람을 기다려 떠났다고 적어 두었습니다.\\n그 뒤로 포구 마을이 커졌고, 도읍도 바다 가까이로 옮겼습니다. 물섬은 뱃사람들이 쉬어 가는 곳이 되었습니다.\\n\\n뱃길이 열리자 솔뫼의 장터에는 먼 섬의 소금과 말린 생선이 들어왔고, 남녘 포구에서는 배를 고치는 일꾼들이 모여 살기 시작했습니다. 바람이 거꾸로 부는 철에는 배들이 물섬에 머물며 다음 바람을 기다렸고, 그동안 섬에는 작은 시장이 섰습니다. 이 글은 그림 옆에서 줄이 좁아졌다가 그림 아래로 내려가면 다시 본문 폭으로 넓어지는지 보려고 길게 적었습니다.\\n * 첫째 포구 — 솔뫼\\n * 둘째 포구 — 물섬\\n * 셋째 포구 — 남녘 포구\\n== 도읍 ==\\n[[파일:달내 성.webp|align=center|width=60%]]\\n첫 도읍은 달내, 590년부터는 솔뫼입니다.\\n[[파일:지운 그림.webp]]\\n[각주]\",\"pack\":\"샘플: 문서 그림 — 오른쪽에 띄운 그림과 흐르는 글\",\"uid\":\"sample-doc-images/p-haeon\",\"span\":[-762626880,-678474720],\"images\":{\"남쪽 바닷길.webp\":{\"key\":\"img:sample-doc-images/img-sea\",\"mime\":\"image/webp\",\"bytes\":8316,\"w\":800,\"h\":450,\"caption\":\"남쪽 바닷길 — 포구 셋을 잇는 뱃길 (확인용 그림)\",\"alt\":\"솔뫼 · 물섬 · 남녘 포구를 점선 뱃길로 이은 바다 그림\",\"credit\":\"확인용 견본\"},\"달내 성.webp\":{\"key\":\"img:sample-doc-images/img-castle\",\"mime\":\"image/webp\",\"bytes\":3586,\"w\":640,\"h\":360,\"caption\":\"달내 성 — 첫 도읍의 성벽 (확인용 그림)\"}}}","pack":0},{"uid":"sample-doc-images/p-haeon","kind":"period","json":"{\"id\":\"p-haeon\",\"track\":\"docimg-sea\",\"name\":\"해온국\",\"start\":520,\"end\":680,\"leaders\":[{\"name\":\"솔빛\",\"start\":520,\"end\":552,\"ordinal\":1},{\"name\":\"가람\",\"start\":552,\"end\":590,\"ordinal\":2},{\"name\":\"누리\",\"start\":590,\"end\":680,\"ordinal\":3}],\"capitals\":[{\"city\":\"달내\",\"start\":520,\"end\":590,\"role\":\"main\",\"name\":\"달내\",\"endY\":590,\"endYAt\":null},{\"city\":\"솔뫼\",\"start\":590,\"end\":680,\"role\":\"main\",\"name\":\"솔뫼\",\"endY\":680,\"endYAt\":null}],\"polityKind\":\"state\",\"itemKind\":\"period\",\"kind\":\"period\",\"uid\":\"sample-doc-images/p-haeon\",\"packId\":\"sample-doc-images\",\"packName\":\"샘플: 문서 그림 — 오른쪽에 띄운 그림과 흐르는 글\",\"endY\":680,\"certainty\":\"accepted\",\"spanMin\":520,\"spanMax\":680,\"colorAuto\":true,\"color\":\"#c8b193\",\"peopleId\":null,\"peoplePath\":[],\"members\":[],\"hosts\":[],\"dynasties\":[],\"singleHost\":false,\"successors\":[],\"predecessors\":[],\"servedBy\":[],\"wiki\":\"== 개요 ==\\n'''해온국'''은 이 견본의 확인용 가상 나라입니다. 바닷길을 열고 도읍을 두 번 옮겼다고 적어 두었습니다.\\n== 바닷길 ==\\n[[파일:남쪽 바닷길.webp]]\\n두 번째 임금 때 남쪽 바다로 나가는 길을 열었습니다.[* 확인용 각주 — 고증 아님] 포구 셋을 잇는 뱃길이었고, 철마